# -*- coding: utf-8 -*-
"""AI 密钥本地配置模板（默认使用「永久免费」的智谱 GLM-4-Flash）。

== 免费拿 Key（约 1 分钟，手机号即开，不花钱、不限免费期）==
1. 打开 https://open.bigmodel.cn 用手机号注册登录；
2. 右上角头像 -> 「API Keys」-> 「添加新的 API Key」，复制生成的 key
   （形如 xxxxxxxx.yyyyyyyy，新用户另送 2000 万 Token）；
3. 把 key 填入下方 AI_API_KEY；或更推荐设置环境变量（优先级更高）：
     PC_AI_API_KEY=<你的key>
   EdgeOne 线上免重建配置：
     edgeone makers env set PC_AI_API_KEY "<你的key>" -e production

GLM-4-Flash 为官方「永久免费」模型，默认端点/模型已配好，填 key 即可用。
如需换成火山方舟 / OpenAI / 硅基流动等其它 OpenAI 兼容服务，
再修改下方 BASE_URL / MODEL（或设 PC_AI_BASE_URL / PC_AI_MODEL）。
"""

AI_API_KEY = ""  # 形如 "xxxxxxxx.yyyyyyyy"
AI_BASE_URL = "https://open.bigmodel.cn/api/paas/v4"
AI_MODEL = "glm-4-flash"  # 永久免费；想试更新的多模态可用 "glm-5.3-flash"
